# E6 — fine-tuning do GPT-2 (124M) pré-treinado pela OpenAI, com os mesmos dados do E3.
# Tamanho do modelo (12 camadas, 12 cabeças, 768 dim) é fixado pelos pesos do GPT-2.
out_dir = '/content/runs/e6'
eval_interval = 500
eval_iters = 200
log_interval = 10
always_save_checkpoint = False

wandb_log = False
dataset = 'machado_gpt2'
init_from = 'gpt2'

# 8 sequências por vez × 8 acumulações = 64 sequências por passo, como no E1 e no E3,
# mas com memória suficiente para caber na T4
batch_size = 8
gradient_accumulation_steps = 8
block_size = 256

dropout = 0.1

# learning rate 10x menor que no treino do zero, para não apagar o que o GPT-2 já sabe;
# mesmo número de iterações do E3 (5000), para uma comparação justa
learning_rate = 1e-4
max_iters = 5000
lr_decay_iters = 5000
min_lr = 1e-5
warmup_iters = 100

dtype = 'float16'
compile = False

